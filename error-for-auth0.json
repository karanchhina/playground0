{ "error_page": { "html": " <!DOCTYPE html> <html lang='en'> <head> <meta charset='UTF-8'> <meta name='viewport' content='width=device-width, initial-scale=1.0'> <title>Error Page</title> <style> body { font-family: 'Courier New', Courier, monospace; background-color: #000; margin: 0; padding: 20px; display: flex; justify-content: center; align-items: center; min-height: 100vh; color: #4ade80; } .error-card { background-color: #000; border: 2px solid #4ade80; box-shadow: 0 0 20px rgba(0, 255, 0, 0.5); padding: 40px; max-width: 800px; width: 90%; } h2 { color: #4ade80; margin-top: 0; font-size: 1.5em; text-align: center; margin-bottom: 30px; text-transform: uppercase; font-weight: lighter; } dl { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; } dt { font-weight: bold; color: #4ade80; font-size: 1.1em; font-weight: lighter; } dd { margin-left: 0; color: #4ade80; font-size: 1.1em; font-weight: lighter; } @media (max-width: 600px) { dl { grid-template-columns: 1fr; } .error-card { padding: 30px; } } .blink { animation: blink-animation 1s steps(5, start) infinite; } @keyframes blink-animation { to { visibility: hidden; } } </style> </head> <body> <div class='error-card'> <h2>> Something went wrong <span class='blink'>_</span></h2> <dl> <dt>> Error:</dt> <dd>{{error | escape}}</dd> <dt>> Error Description:</dt> <dd>{{error_description | escape}}</dd> <dt>> Tracking:</dt> <dd>{{tracking | escape}}</dd> <dt>> Client ID:</dt> <dd>{{client_id | escape}}</dd> <dt>> Connection:</dt> <dd>{{connection | escape}}</dd> </dl> </div> </body> </html>", "show_log_link": false, "url": "" } }